# Lokale Git-Authentifizierung (wird NIE committet — siehe .gitignore: .env.git)
#
# 1) Kopieren:  cp .env.git.example .env.git
# 2) Fine-grained PAT eintragen (mindestens: Repository → Contents: Read and write)
#
# Push:
#   ./scripts/git-push-with-env.sh
#   ./scripts/git-push-with-env.sh main
#
# Fetch:
#   ./scripts/git-fetch-with-env.sh
#   ./scripts/git-fetch-with-env.sh main
#
GITHUB_TOKEN=
