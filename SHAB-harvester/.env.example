# Copy to .env and adjust as needed. Every variable here is optional —
# unset ones fall back to the defaults shown below (the project's original,
# conservative values). Real environment variables always take precedence
# over .env file values. See shab_harvester/config.py for how these are read.

# --- Politeness: pause between detail-page scrapes (seconds) ---------------
# Lower = faster harvesting, higher risk of being rate-limited/blocked.
SHAB_SCRAPE_PAUSE_MIN=1.0
SHAB_SCRAPE_PAUSE_MAX=3.0

# --- Rate-limit handling -----------------------------------------------------
# Backoff range (seconds) after a 429/403 response from shab.ch.
SHAB_RATE_LIMIT_BACKOFF_MIN=60
SHAB_RATE_LIMIT_BACKOFF_MAX=300
# Abort the whole scrape-pending run after this many consecutive 429/403s.
SHAB_MAX_CONSECUTIVE_RATE_LIMITS=2

# --- Retry limit for failed publication_queue items -------------------------
# A failed item is retried while attempt_count is below this.
SHAB_MAX_QUEUE_ATTEMPTS=3

# --- Playwright timeouts (milliseconds) -------------------------------------
# Generic wait_for_selector timeout (date filter, detail page sections).
SHAB_PAGE_TIMEOUT_MS=30000
# How long discover_day waits for the date-filtered API response before
# falling back to (unreliable) DOM polling.
SHAB_FILTERED_RESPONSE_TIMEOUT_MS=20000

# --- Infinite-scroll loading of the discovery results list ------------------
SHAB_SCROLL_MAX_ROUNDS=200
SHAB_SCROLL_WAIT_MS=800
SHAB_SCROLL_STABLE_ROUNDS=5

# --- Scroll nudges to provoke the date-filtered API response ----------------
# (see discovery.py's `trigger()` — a single scroll isn't always enough to
# make the SPA fire the filtered request.)
SHAB_TRIGGER_SCROLL_ATTEMPTS=10
SHAB_TRIGGER_SCROLL_WAIT_MS=500

# --- Browser / server defaults ----------------------------------------------
# Default for --headless on every CLI command unless overridden with
# --headless/--no-headless explicitly.
SHAB_HEADLESS_DEFAULT=false
SHAB_WEBUI_HOST=127.0.0.1
SHAB_WEBUI_PORT=8765

# --- Paths -------------------------------------------------------------------
# Absolute path to the sqlite file. Defaults to data/shab_harvester.sqlite
# under the project root.
# SHAB_DB_PATH=/absolute/path/to/shab_harvester.sqlite
